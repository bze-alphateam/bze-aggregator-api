HTTP_PORT=8888
LOG_LEVEL=info
# BZE Scan base URL including its /aggregator prefix, e.g.
# https://explorer.getbze.com/aggregator. Every /api request except the health
# checks is answered from there. Scan runs blue/green on two ports, so use a
# stable address such as its public host, not one backend port.
SCAN_API_HOST=
# Chain REST, for /api/health/market.
BLOCKCHAIN_REST_HOST=
# Nodes compared by /api/health/nodes.
HEALTH_NODES={{name}}={{protocol:HOST:PORT}},{{name2}}={{protocol:HOST2:PORT2}}
# REST host per address prefix, for /api/health/balances.
PREFIXED_REST_HOSTS={{prefix}}={{protocol:HOST:PORT}},{{prefix2}}={{protocol:HOST2:PORT2}}
