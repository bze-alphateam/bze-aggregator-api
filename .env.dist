# user:password@tcp(host:3306)/dbname?parseTime=true&timeTruncate=1us
# parseTime=true: DATETIME columns scan into time.Time.
# timeTruncate=1us: without it time params are sent with nanosecond precision
# and MariaDB cannot use an index range on them (slow tickers/intervals).
MYSQL_DSN=
POSTGRES_DSN=
BLOCKCHAIN_WS_HOST=
HEALTH_NODES={{name}}={{protocol:HOST:PORT}},{{name2}}={{protocol:HOST2:PORT2}}

PREFIXED_REST_HOSTS={{prefix}}={{protocol:HOST:PORT}},{{prefix2}}={{protocol:HOST2:PORT2}}
NATIVE_DENOM=ubze
USDC_DENOM=
