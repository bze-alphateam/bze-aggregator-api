HTTP_PORT=8888
LOG_LEVEL=info
BLOCKCHAIN_RPC_HOST=
BLOCKCHAIN_REST_HOST=
BLOCKCHAIN_GRPC_HOST=
BLOCKCHAIN_GRPC_USE_TLS=
COINGECKO_PRICE_IDS=
COINGECKO_HOST=
# Markets folded into a market CoinGecko already tracks, for format=coingecko only:
# {{new market id}}={{tracked market id}},... The tracked ticker reports both markets'
# volume and the new market's price, book and trades; the new ticker is not listed.
# Mainnet USDC.n -> USDC.inj:
# ubze/ibc/81DA528F4C5546208D1D50F84C2D0B388B45D37AA36FCA622A3CB2D8EF014838=ubze/ibc/6490A7EAB61059BFC1CDDEB05917DD70BDF3A611654162A1A47DB930D40D8AF4
COINGECKO_MERGED_MARKETS=
# user:password@tcp(host:3306)/dbname?parseTime=true&timeTruncate=1us
# parseTime=true: DATETIME columns scan into time.Time.
# timeTruncate=1us: without it time params are sent with nanosecond precision
# and MariaDB cannot use an index range on them (slow tickers/intervals).
MYSQL_DSN=
POSTGRES_DSN=
BLOCKCHAIN_WS_HOST=
HEALTH_NODES={{name}}={{protocol:HOST:PORT}},{{name2}}={{protocol:HOST2:PORT2}}

PREFIXED_REST_HOSTS={{prefix}}={{protocol:HOST:PORT}},{{prefix2}}={{protocol:HOST2:PORT2}}
NATIVE_DENOM=ubze
USDC_DENOM=
# Answer endpoints from BZE Scan, the aggregator's own handlers as failover
# (README, "Proxying to BZE Scan"). Base URL including Scan's /aggregator prefix,
# e.g. https://explorer.getbze.com/aggregator. Scan runs blue/green on two ports,
# so use a stable address such as its public host, not one backend port.
SCAN_API_HOST=
# Comma-separated: prices,supply,articles,orders,swaps,history,intervals,tickers
# Empty proxies nothing.
SCAN_PROXIED_ENDPOINTS=
